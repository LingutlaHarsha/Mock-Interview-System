    "code": "\nclass Solution:\n    def solve(self, input_data):\n        n = len(input_data) // 2\n\n        l1 = input_data[:n]\n        l2 = input_data[n:]\n\n        result = []\n        carry = 0\n\n        for i in range(n):\n            total = l1[i] + l2[i] + carry\n            result.append(total % 10)\n            carry = total // 10\n\n        if carry:\n            result.append(carry)\n\n        return \" \".join(map(str, result))\n",
